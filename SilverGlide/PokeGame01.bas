DIM P(31,2)
DIM E$(0)*34

' --- 初期ロード or スキップの選択
CLS
LOCATE 4,1:PRINT"1:LOAD  2:SKIP"
LOCATE 1,3:PRINT"INITIAL LOAD REQUIRED"
*KEYWAIT1
Z$=INKEY$
IF Z$="1" THEN *LLOAD
IF Z$="2" THEN *LSKIP
GOTO *KEYWAIT1

' --- 初期ロード
*LLOAD
CLS
PRINT "WRITING MACHINE CODE.."
PRINT "WAIT ABOUT 10 SECONDS"
PRINT "KEEP POWER ON!"
PRINT "------------------------"
C=&H100:D=0:E=33:READ E$(0)
WHILE E$(0)<>"END"
  FOR A=1 TO LEN(E$(0))-1 STEP 2
    POKE C,VAL("&H"+MID$(E$(0),A,2))
    C=C+1
  NEXT A
  D=D+1
  LOCATE 0,4:F=INT(D/E*22):PRINT "[";STR$(INT(D/E*100));"%]"
  LOCATE 0,5:PRINT "[";LEFT$("**********************",F);RIGHT$("----------------------",22-F);"]";
  LOCATE 22,0:PRINT MID$("/-|.", (D MOD 4) + 1, 1);
  READ E$(0)
WEND

' --- タイトル画面
*LSKIP
CLS
LOCATE 5,2:PRINT"SILVER GLIDE"
LOCATE 5,4:PRINT"press 1 start"
*KEYWAIT2
Z$=INKEY$
IF Z$="1" THEN *LGAME
GOTO *KEYWAIT2

' --- ゲーム本体
*LGAME
CLS
LINE(47,0)-(47,47)
LOCATE 0,1:PRINT"SILVER"
LOCATE 0,2:PRINT" GLIDE"

L=1:S=0:W=60:G=0:T=20
P(0,0)=2:P(0,1)=40:P(0,2)=28
FOR I=1 TO 31:P(I,0)=0:NEXT I

' --- メインループ
WHILE L=1
 X=P(0,1):Y=P(0,2)

 ' --- 自機挙動
 IF X<W THEN X=X+1
 IF W<136 THEN W=W+0.15
 Z$=INKEY$
 IF Z$="1" THEN
  G=G-0.8
 ELSE
  G=G+0.4
 ENDIF
 Y=Y+G

 ' --- ランダムで柱出現（位置、サイズもランダム）
 T=T-1
 IF T<=0 THEN
  T=7+(RND 9)
  R=RND 100
  IF R<=20 THEN
   A=7+(RND 40)
   GOSUB *POST
  ELSEIF R<=60 THEN
   A=7+(RND 32)
   GOSUB *POST:A=A+8:GOSUB *POST
  ELSE
   A=7+(RND 26)
   GOSUB *POST:A=A+8:GOSUB *POST:A=A+8:GOSUB *POST
  ENDIF
 ENDIF

 ' --- 存在する柱の移動。自機との当り判定
 H=0
 FOR I=1 TO 31
  IF P(I,0)>0 THEN
   P(I,1)=P(I,1)-3:IF P(I,1)<=40 THEN P(I,0)=0
   PX=P(I,1):PY=P(I,2)
   IF PX-6<X AND PX+6>X AND PY-6<Y AND PY+6>Y THEN H=1
  ENDIF
 NEXT I
 ' --- 自機上下画面外判定
 IF Y<-1 OR Y>58 THEN H=1
 IF H<>0 THEN
  P(0,0)=3:L=0  '死亡判定
 ENDIF

 P(0,1)=X:P(0,2)=Y
 IF S<100000 THEN S=S+1
 'VRAM式スプライト描画
 CALL &H100
 '点数表示
 LOCATE 1,4:PRINT USING "#####";S
WEND

WAIT 100:PRINT"":WAIT 0

' --- GAME OVER画面
CLS
LOCATE 7,1:PRINT"GAME OVER"
LOCATE 9,2:PRINT USING "#####";S
LOCATE 6,4:PRINT"2:retry 3:end"
*KEYWAIT3
Z$=INKEY$
IF Z$="2" THEN *LGAME
IF Z$="3" THEN *LEND
GOTO *KEYWAIT3

*LEND
CLS
CLEAR
END

' --- 柱１マス生成
*POST
FOR I1=1 TO 31
 IF P(I1,0)=0 THEN
  P(I1,0)=1:P(I1,1)=144:P(I1,2)=A
  I1=31
 ENDIF
NEXT I1
RETURN

