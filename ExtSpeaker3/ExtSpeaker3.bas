DIM M$(0)*64,D$(6)*64,E$(0)*34,L$(0)*34

CLS:PRINT ""
PRINT"1:BEEP  2:CHORD"
*KEYWAIT
Z$=INKEY$
IF Z$="1" THEN *LBEEP
IF Z$="2" THEN *LCHORD
GOTO *KEYWAIT

' --- BEEP演奏
*LBEEP
FOR A=0 TO 5:READ D$(A):NEXT A
READ E$(0)
WHILE E$(0)<>"END"
  READ E$(0)
WEND
GOSUB *LOGO

M$(0)="$9":GOSUB *OMP
M$(0)=D$(0):GOSUB *OMP
M$(0)=D$(1):GOSUB *OMP
WHILE 1
 FOR B=2 TO 5:M$(0)=D$(B):GOSUB *OMP:NEXT B
WEND
END

' --- 和音演奏
*LCHORD
CLS
PRINT "WRITING MACHINE CODE.."
PRINT "WAIT ABOUT 60 SECONDS"
PRINT "KEEP POWER ON!"
PRINT "------------------------"
FOR A=0 TO 5:READ D$(A):NEXT A
C=&H100:D=0:E=161:READ E$(0)
WHILE E$(0)<>"END"
  FOR A=1 TO LEN(E$(0))-1 STEP 2
    POKE C,VAL("&H"+MID$(E$(0),A,2))
    C=C+1
  NEXT A
  D=D+1
  LOCATE 0,4:F=INT(D/E*22):PRINT "[";STR$(INT(D/E*100));"%]"
  LOCATE 0,5:PRINT "[";LEFT$("**********************",F);RIGHT$("----------------------",22-F);"]";
  LOCATE 22,0:PRINT MID$("/-|.", (D MOD 4) + 1, 1);
  READ E$(0)
WEND
GOSUB *LOGO
CALL &H100
END

' --- ロゴ表示
*LOGO
CLS
FOR A=1 TO 6
  FOR B=0 TO 8:READ L$(0):GCURSOR(16*B,8*A):GPRINT L$(0):NEXT B
NEXT A
RETURN

' --- Ochame's Music Plug-in ---
*OMP FOR I=1 TO LEN M$(0):Z=ASC MID$ (M$(0),I,1):IF Z>64 LET X=6.13*TEN (0.02508*Z):BEEP 1,59091/X-7,X*Y/T:NEXT :RETURN
IF Z>47 LET Y=Z-48:NEXT :RETURN
IF Z=36 LET T=VAL RIGHT$ (M$(0),LEN M$(0)-I)
IF Z=42 FOR J=1 TO 535*Y/T+20:NEXT
NEXT :RETURN

