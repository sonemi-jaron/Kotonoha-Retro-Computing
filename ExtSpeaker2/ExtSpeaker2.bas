DIM M$(0)*250

CLS
PRINT ""
PRINT"BEEP PLAYING"
WAIT 128
PRINT"(PRESS [BREAK] TO STOP)"
WAIT 0

' --- 導入 ---
M$(0)="$9":GOSUB *OMP

M$(0)="@*":GOSUB *OMP
M$(0)="2A2D2H2E2H2J2H2M2P2M2Q2T":GOSUB *OMP
M$(0)="1T1T4T2U2V2U2T2S":GOSUB *OMP
M$(0)="2T1*1H8H8*":GOSUB *OMP

' --- メインテーマ ---
M$(0)="$6":GOSUB *OMP

WHILE 1
 M$(0)="2*4V2U4T2SR":GOSUB *OMP
 M$(0)="1P1Q1*1O1Q1*1O1Q1*1D1E1D2E2I":GOSUB *OMP

 M$(0)="2*4V2U4T2S2R":GOSUB *OMP
 M$(0)="1P1Q1*1O1Q1*1O1Q1*1D1E1D2E2I":GOSUB *OMP

 M$(0)="1U1V1*1U1V1*2M1U1V1*1U1V1*2N":GOSUB *OMP
 M$(0)="1U1V1*1U1V1*2M1U1V1*1U1V1*2N":GOSUB *OMP

 M$(0)="1Q1Q2Q2*2I1Q1Q2Q2*2V":GOSUB *OMP
 M$(0)="1Q1Q2Q2*2P2Q2*8*":GOSUB *OMP

 M$(0)="8J2*1P1Q1*1P1Q1*":GOSUB *OMP
 M$(0)="8I2*1P1Q1*1P1Q1*":GOSUB *OMP
 M$(0)="8M2*1R1T1*1R1T1*":GOSUB *OMP
 
 M$(0)="2Q4E2Q1*1O1O1O1L1L1I1I":GOSUB *OMP
WEND

END

' --- Ochame's Music Plug-in ---
*OMP FOR I=1 TO LEN M$(0):Z=ASC MID$ (M$(0),I,1):IF Z>64 LET X=6.13*TEN (0.02508*Z):BEEP 1,59091/X-7,X*Y/T:NEXT :RETURN
IF Z>47 LET Y=Z-48:NEXT :RETURN
IF Z=36 LET T=VAL RIGHT$ (M$(0),LEN M$(0)-I)
IF Z=42 FOR J=1 TO 535*Y/T+20:NEXT
NEXT :RETURN