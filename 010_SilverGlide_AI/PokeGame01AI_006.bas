10 CLS:X=20:Y=24:S=0:O=143:REM 初期化
20 PRINT "SCORE:";S
30 REM --- 自機クリア ---
40 PRESET(X,Y):PRESET(X+7,Y):PRESET(X,Y+7):PRESET(X+7,Y+7)
50 REM --- 自機制御 ---
60 K$=INKEY$:IF K$="1" THEN Y=Y-4 ELSE Y=Y+2
70 IF Y<8 THEN Y=8:REM スコア行(Y=0-7)へ行かせない
80 IF Y>40 THEN Y=40:GOTO 300:REM 画面下で死亡
90 REM --- 自機描画 ---
100 PSET(X,Y):PSET(X+7,Y):PSET(X,Y+7):PSET(X+7,Y+7)
110 REM --- 柱制御 ---
120 IF O<=0 THEN O=143:H=RND(3)*8+8:T=RND(2):S=S+1:PRINT @(0,0);"SCORE:";S
130 LINE(O,8)-(O,47),R:REM スコア行を避けて消去(Y=8から開始)
140 O=O-4
150 IF T=0 THEN LINE(O,8)-(O,8+H),S ELSE LINE(O,47-H)-(O,47),S
160 REM --- 衝突判定 ---
170 IF POINT(X,Y)=1 OR POINT(X+7,Y)=1 OR POINT(X,Y+7)=1 OR POINT(X+7,Y+7)=1 THEN GOTO 300
180 GOTO 30
300 CLS:PRINT "GAME OVER":PRINT "SCORE:";S:END