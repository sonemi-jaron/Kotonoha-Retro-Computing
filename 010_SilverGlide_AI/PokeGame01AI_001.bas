10 CLEAR:GRAPH:WINDOW 0,0,191,63
20 X=20:Y=30:D=0:S=0:REM 自機X,Y,距離,スコア
30 CLS:GPRINT "DISTANCE:";S
40 REM --- 自機制御 ---
50 K$=INKEY$:IF K$="1" THEN Y=Y-4 ELSE Y=Y+2
60 IF Y<0 THEN Y=0
70 IF Y>55 THEN Y=55
80 REM --- 描画・判定 ---
90 PSET X,Y:PSET X+7,Y:PSET X,Y+7:PSET X+7,Y+7
100 REM --- 柱制御 (簡略版) ---
110 IF O=0 THEN O=191:H=RND(3)*8+8:T=RND(2)
120 LINE O,0,O,63,0
130 O=O-4:IF O<0 THEN O=0:S=S+1:GOTO 30
140 LINE O,0,O,63,1
150 IF T=0 THEN LINE O,0,O,63-H,0 ELSE LINE O,63-H,O,63,0
160 REM --- 衝突判定 ---
170 IF POINT(X+4,Y+4)<>0 THEN GOTO 200
180 GOTO 50
200 CLS:PRINT "GAME OVER":PRINT "SCORE:";S:END