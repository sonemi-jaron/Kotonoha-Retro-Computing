10 CLS:PRINT "SILVER GLIDE 1":PRINT "PRESS 1 KEY TO START"
20 K$=INKEY$:IF K$<>"1" THEN GOTO 20
30 CLS:X=20:Y=24:S=0:O=143:REM 初期化
40 LOCATE 0,0:PRINT "SCORE:";S
50 REM --- 自機クリア ---
60 PRESET(X,Y):PRESET(X+7,Y):PRESET(X,Y+7):PRESET(X+7,Y+7)
70 REM --- 自機制御 ---
80 K$=INKEY$:IF K$="1" THEN Y=Y-4 ELSE Y=Y+2
90 IF Y<8 THEN Y=8:REM スコア行保護
100 IF Y>47 THEN GOTO 300:REM 下端判定を緩和(完全画面外で死亡)
110 REM --- 自機描画 ---
120 PSET(X,Y):PSET(X+7,Y):PSET(X,Y+7):PSET(X+7,Y+7)
130 REM --- 柱制御 ---
140 IF O<=0 THEN O=143:H=RND(2)*8+8:T=RND(2)-1:S=S+1:LOCATE 0,0:PRINT "SCORE:";S
150 LINE(O,8)-(O,47),R:REM 消去
160 O=O-4
170 REM --- 柱描画(T=0上空, T=1地面) ---
180 IF T=0 THEN LINE(O,8)-(O,8+H),S ELSE LINE(O,47-(H-4))-(O,47),S:REM 柱の下側を-4ドット短縮
190 REM --- 座標による当たり判定 ---
200 IF O>=X AND O<=X+7 AND (T=0 AND Y<8+H OR T=1 AND Y>47-(H-4)-7) THEN GOTO 300
210 GOTO 50
300 CLS:PRINT "GAME OVER":PRINT "SCORE:";S:PRINT "PRESS 1 TO RESTART"
310 K$=INKEY$:IF K$<>"1" THEN GOTO 310
320 GOTO 30