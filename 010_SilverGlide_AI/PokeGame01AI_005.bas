10 CLS:X=20:Y=24:S=0:O=143:REM 初期化
20 PRINT "SCORE:";S
30 REM --- 自機クリア(前フレームの消去) ---
40 PRESET(X,Y):PRESET(X+7,Y):PRESET(X,Y+7):PRESET(X+7,Y+7)
50 REM --- 自機制御 ---
60 K$=INKEY$:IF K$="1" THEN Y=Y-4 ELSE Y=Y+2
70 IF Y<0 THEN Y=0:IF Y>40 THEN Y=40
80 REM --- 自機描画(ON=黒) ---
90 PSET(X,Y):PSET(X+7,Y):PSET(X,Y+7):PSET(X+7,Y+7)
100 REM --- 柱制御 ---
110 IF O<=0 THEN O=143:H=RND(3)*8+8:T=RND(2):S=S+1:CLS:PRINT "SCORE:";S
120 LINE(O,0)-(O,47),R:REM 柱を消去(R=RESET=白)
130 O=O-4
140 REM --- 柱描画(S=SET=黒) ---
150 IF T=0 THEN LINE(O,0)-(O,47-H),S ELSE LINE(O,47-H)-(O,47),S
160 REM --- 衝突判定 ---
170 IF POINT(X+4,Y+4)=1 THEN GOTO 300
180 GOTO 30
300 CLS:PRINT "GAME OVER":PRINT "SCORE:";S:END