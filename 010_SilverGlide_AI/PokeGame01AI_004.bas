10 CLS:X=20:Y=24:S=0:O=143:REM 初期化
20 PRINT "SCORE:";S
30 REM --- 自機クリア ---
40 PSET(X,Y),S:PSET(X+7,Y),S:PSET(X,Y+7),S:PSET(X+7,Y+7),S
50 REM --- 自機制御 ---
60 K$=INKEY$:IF K$="1" THEN Y=Y-4 ELSE Y=Y+2
70 IF Y<0 THEN Y=0
80 IF Y>40 THEN Y=40
90 REM --- 自機描画 ---
100 PSET(X,Y),R:PSET(X+7,Y),R:PSET(X,Y+7),R:PSET(X+7,Y+7),R
110 REM --- 柱制御 ---
120 IF O<=0 THEN O=143:H=RND(3)*8+8:T=RND(2):S=S+1
130 LINE(O,0)-(O,47),S:REM 柱を消去(背景と同色)
140 O=O-4
150 REM --- 柱描画 ---
160 IF T=0 THEN LINE(O,0)-(O,47-H),R ELSE LINE(O,47-H)-(O,47),R
170 REM --- 衝突判定 ---
180 IF POINT(X+4,Y+4)=1 THEN GOTO 300
190 GOTO 30
300 CLS:PRINT "GAME OVER":PRINT "SCORE:";S:END