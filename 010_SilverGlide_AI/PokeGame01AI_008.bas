10 CLS:X=20:Y=24:S=0:O=143:REM 初期化
20 LOCATE 0,0:PRINT "SCORE:";S
30 REM --- 自機クリア ---
40 PRESET(X,Y):PRESET(X+7,Y):PRESET(X,Y+7):PRESET(X+7,Y+7)
50 REM --- 自機制御 ---
60 K$=INKEY$:IF K$="1" THEN Y=Y-4 ELSE Y=Y+2
70 IF Y<8 THEN Y=8:REM スコア行保護
80 IF Y>44 THEN GOTO 300:REM 画面下に機体が完全に出たら死亡(44で判定)
90 REM --- 自機描画 ---
100 PSET(X,Y):PSET(X+7,Y):PSET(X,Y+7):PSET(X+7,Y+7)
110 REM --- 柱制御 ---
120 IF O<=0 THEN O=143:H=RND(3)*8+8:T=RND(2)-1:S=S+1:LOCATE 0,0:PRINT "SCORE:";S
130 LINE(O,8)-(O,47),R:REM 消去
140 O=O-4
150 REM --- 柱描画(T=0で上空、T=1で地面) ---
160 IF T=0 THEN LINE(O,8)-(O,8+H),S ELSE LINE(O,47-H)-(O,47),S
170 REM --- 座標による当たり判定 ---
180 IF O>=X AND O<=X+7 AND (T=0 AND Y<8+H OR T=1 AND Y>47-H-7) THEN GOTO 300
190 GOTO 30
300 CLS:PRINT "GAME OVER":PRINT "SCORE:";S:END