DIM M$(0)*250

CLS
PRINT ""
WAIT 128
PRINT"BEEP MUSIC"
WAIT 0

M$(0)="$6":GOSUB *OMP

FOR A=1 TO 2
 ' イントロ
 M$(0)="1Q2Q1Q1*1M2Q2T4*2H2*":GOSUB *OMP
 ' Ａメロ
 M$(0)="2*1M4*1H2*2E2*2J2L1K1J":GOSUB *OMP
 M$(0)="2*1H1Q1T2V1R1T1*2Q1M1O2L":GOSUB *OMP
 ' Ａメロ繰り返し
 M$(0)="2*1M4*1H2*2E2*2J1L1K1J":GOSUB *OMP
 M$(0)="2*1H1Q1T2V1R1T1*2Q1M1O2L":GOSUB *OMP
 ' Ｂメロ
 M$(0)="4*1T1S1R2P1Q1*1I1J1M1*1J1M1O":GOSUB *OMP
 M$(0)="4*1T1S1R2P1Q1*2Y1Y4Y":GOSUB *OMP
 M$(0)="4*1T1S1R2P1Q1*1I1J1M1*1J1M1O":GOSUB *OMP
 M$(0)="4*1P4*1O4*4M8*":GOSUB *OMP
 ' Ｂメロ繰り返し
 M$(0)="4*1T1S1R2P1Q1*1I1J1M1*1J1M1O":GOSUB *OMP
 M$(0)="4*1T1S1R2P1Q1*2Y1Y4Y":GOSUB *OMP
 M$(0)="4*1T1S1R2P1Q1*1I1J1M1*1J1M1O":GOSUB *OMP
 M$(0)="4*1P4*1O4*2M8*":GOSUB *OMP
 'Ｃメロ
 M$(0)="4*1M1M1*1M1*1M1O1*1Q1M1*1J1H4*":GOSUB *OMP
 M$(0)="2*1M1M1*1M1*1M1O1Q8*":GOSUB *OMP
 'Ｃメロ前半繰り返し
 M$(0)="4*1M1M1*1M1*1M1O1*1Q1M1*1J1H4*":GOSUB *OMP
NEXT A

END

' --- Ochame's Music Plug-in ---
*OMP FOR I=1 TO LEN M$(0):Z=ASC MID$ (M$(0),I,1):IF Z>64 LET X=6.13*TEN (0.02508*Z):BEEP 1,59091/X-7,X*Y/T:NEXT :RETURN
IF Z>47 LET Y=Z-48:NEXT :RETURN
IF Z=36 LET T=VAL RIGHT$ (M$(0),LEN M$(0)-I)
IF Z=42 FOR J=1 TO 535*Y/T+20:NEXT
NEXT :RETURN