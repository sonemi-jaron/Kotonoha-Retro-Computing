DIM D$(6)*64,E$(0)*34,L$(0)*34

' --- 和音演奏
*LCHORD
CLS
PRINT "WRITING MACHINE CODE.."
PRINT "WAIT ABOUT 60 SECONDS"
PRINT "KEEP POWER ON!"

PRINT "------------------------"
C=&H100:D=0:E=141:READ E$(0)
WHILE E$(0)<>"END"
  FOR A=1 TO LEN(E$(0))-1 STEP 2
    POKE C,VAL("&H"+MID$(E$(0),A,2))
    C=C+1
  NEXT A
  D=D+1
  LOCATE 0,4:F=INT(D/E*22):PRINT "[";STR$(INT(D/E*100));"%]"
  LOCATE 0,5:PRINT "[";LEFT$("**********************",F);RIGHT$("----------------------",22-F);"]";
  LOCATE 22,0:PRINT MID$("/-|.", (D MOD 4) + 1, 1);
  READ E$(0)
WEND

GOSUB *LOGO

*LPLAY
LOCATE 5,5:PRINT"              "
CALL &H100

LOCATE 5,5:PRINT"1:REPLAY 2:END"
*KEYWAIT
Z$=INKEY$
IF Z$="1" THEN *LPLAY
IF Z$="2" THEN *LEND
GOTO *KEYWAIT
*LEND
END

' --- ロゴ表示
*LOGO
CLS
FOR A=1 TO 4
  FOR B=0 TO 7:READ L$(0):GCURSOR(12+16*B,8+8*A):GPRINT L$(0):NEXT B
NEXT A
RETURN

