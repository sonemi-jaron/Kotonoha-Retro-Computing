 730 IF P(I,0)>0 THEN
 740 P(I,1)=P(I,1)-3:IF P(I,1)<=40 THEN P(I,0)=0
 750 PX=P(I,1):PY=P(I,2)
 760 IF PX-6<X AND PX+6>X AND PY-6<Y AND PY+6>Y THEN H=1
 770 ENDIF
 780 NEXT I
 790 IF Y<-1 OR Y>58 THEN H=1
 800 IF H<>0 THEN
 810 P(0,0)=3:L=0
 820 ENDIF
 830 P(0,1)=X:P(0,2)=Y
 840 IF S<100000 THEN S=S+1
 850 CALL &H100
 860 LOCATE 1,4:PRINT USING "#####";S
 870 WEND
 880 WAIT 100:PRINT"":WAIT 0
