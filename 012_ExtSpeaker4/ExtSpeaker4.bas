DIM M$(0)*64,D$(6)*64,E$(0)*34,L$(0)*34

CLS
X=0:W=8:H=3:GOSUB *SUBLOGO
LOCATE 5,4:PRINT"1:LOAD  2:SKIP"
*KEYWAIT
Z$=INKEY$
IF Z$="1" THEN *LLOAD
IF Z$="2" THEN FOR A=1 TO 386:READ M$(0):NEXT A:GOTO *LSKIP
GOTO *KEYWAIT

*LLOAD
GOSUB *SUBLOAD
*LSKIP
CLS
LOCATE 0,1:PRINT" PRESS"
LOCATE 0,2:PRINT"[BREAK]"
LOCATE 0,3:PRINT"TO STOP"
X=44:W=4:H=6:GOSUB *SUBLOGO
CALL &H100
END

' --- ロゴ表示
*SUBLOGO
FOR A=1 TO H
  FOR B=0 TO W:READ L$(0):GCURSOR(X+16*B,8*A):GPRINT L$(0):NEXT B
NEXT A
RETURN

' --- 「mml演奏機械語＋和音曲データ」ロード
*SUBLOAD
LOCATE 1,4:PRINT "WRITING MACHINE CODE.."
C=&H100:D=0:E=386:READ E$(0)
WHILE E$(0)<>"END"
  FOR A=1 TO LEN(E$(0))-1 STEP 2
    POKE C,VAL("&H"+MID$(E$(0),A,2))
    C=C+1
  NEXT A
  D=D+1
  LOCATE 18,5:PRINT "[";STR$(INT(D/E*100));"%]"
  READ E$(0)
WEND
RETURN

